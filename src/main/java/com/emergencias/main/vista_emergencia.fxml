<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="15.0" prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.emergencias.controller.EmergencyManager" style="-fx-padding: 20;">
   <children>
      <Label text="SISTEMA EMERLINK - GESTIÓN" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
      
      <VBox spacing="5.0">
         <Label text="ID de Reserva (para Actualizar/Borrar):" />
         <TextField fx:id="txtId" promptText="ID" />
         <Label text="Detalle de la reserva:" />
         <TextField fx:id="txtDetalle" promptText="Detalle" />
      </VBox>

      <HBox alignment="CENTER" spacing="10.0">
         <Button mnemonicParsing="false" onAction="#handleCrear" text="Insertar (Create)" style="-fx-background-color: #28a745; -fx-text-fill: white;" />
         <Button mnemonicParsing="false" onAction="#handleConsultar" text="Consultar (Read)" style="-fx-background-color: #007bff; -fx-text-fill: white;" />
      </HBox>
      
      <HBox alignment="CENTER" spacing="10.0">
         <Button mnemonicParsing="false" onAction="#handleActualizar" text="Modificar (Update)" style="-fx-background-color: #ffc107; -fx-text-fill: black;" />
         <Button mnemonicParsing="false" onAction="#handleEliminar" text="Eliminar (Delete)" style="-fx-background-color: #dc3545; -fx-text-fill: white;" />
      </HBox>

      <Button mnemonicParsing="false" onAction="#handleEnviarAlerta" text="ENVIAR ALERTA DE EMERGENCIA" style="-fx-background-color: red; -fx-text-fill: white; -fx-padding: 10 20;" />
   </children>
</VBox>